{
  // Datasets shown by the viewer: an nli_filter.py output folder + the corpus it was made from.
  // Paths are relative to this file. Remote examples: see viewer_config.example.json
  "cache_dir": ".viewer_cache",
  "cache_max_gb": 20,
  "cors_origins": [
    "http://localhost:3000",
    "http://127.0.0.1:3000"
  ],
  "datasets": [
    {
      "name": "test_corpus",
      "corpus": "../test_corpus",
      "output": "../out_test_corpus",
      "editable": true
    },
    {
      "name": "germany",
      "title": "Germany test",
      "corpus": "../test_corpus_de",
      "output": "../out_test_corpus_de"
    },
    {
      "name": "longtest",
      "title": "Russia Long test",
      "corpus": "../test_corpus_long",
      "output": "../out_test_corpus_long",
      "editable": true
    },
    {
      "name": "ru_plain",
      "title": "test_russia: russian.json",
      "corpus": "../test_ru",
      "output": "../out_ru_plain"
    },
    {
      "name": "ru_kw",
      "title": "test_russia: russian_kw.json",
      "corpus": "../test_ru",
      "output": "../out_ru_kw"
    },
    {
      "name": "sftp_test",
      "title": "test_russia: russian_kw.json",
      "corpus": "sftp://download:download@192.168.170.200/home/download/hkc_test/test_corpus",
      "output": "D:/hkc/sftp_run/out_test_corpus",
      "editable":true
    }
  ]
}