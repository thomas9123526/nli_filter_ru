{
  // Datasets shown by the viewer: an nli_filter.py output folder + the corpus it was made from.
  // Paths are relative to this file. Remote examples: see viewer_config.example.json
  "cache_dir": ".viewer_cache",
  "cache_max_gb": 20,
  "cors_origins": [
    "http://localhost:3000",
    "http://127.0.0.1:3000"
  ],
  // Dynamic datasets: every run folder in this folder is paired with the corpus it was made from (as recorded in its
  // summary.json); the most recent nli_filter.py run and the most recent nli_label.py run per corpus are shown, next
  // to the datasets below (these always win). Report of all run folders: python -m nli_viewer runs
  "auto_datasets": "../dataset",
  // Translate buttons (中文 / Русский), for reading only. Providers are tried in order; see cmds/viewer/translate.md.
  // Keys only via environment variables ("api_key_env"); unset = no Authorization header.
  "translate": {
    "targets": ["zh", "ru"],
    "providers": [
      {"name": "qwen", "kind": "openai", "base_url": "http://192.168.170.108:8000/v1", "model": "qwen3-4b",
       "api_key_env": "QWEN_API_KEY", "timeout": 60, "no_think": true},
      // Hunyuan-MT-7B, OpenAI-compatible on port 8001: vLLM (Linux / H200) or tools/serve_translate_local.py (this PC)
      {"name": "hunyuan", "kind": "openai", "base_url": "http://127.0.0.1:8001/v1", "model": "Hunyuan-MT-7B",
       "prompt": "hunyuan", "timeout": 120},
      // the same model via tools/serve_translate_local.py on another port (transformers, Windows without WSL)
      {"name": "hunyuan_local", "kind": "local", "base_url": "http://127.0.0.1:8002/v1", "model": "Hunyuan-MT-7B",
       "prompt": "hunyuan", "timeout": 180, "enabled": false}
    ]
  },
  "datasets": [
    {
      "name": "sftp_test",
      "title": "test_russia: russian_kw.json",
      "corpus": "sftp://download:download@192.168.170.200/home/download/hkc_test/test_corpus",
      "output": "D:/hkc/sftp_run/out_test_corpus",
      "editable": true
    },
    {
      "name": "test",
      "title": "testing",
      "corpus": "D:/hkc/nli_filter2/dataset/simple_test_corpus",
      "output": "D:/hkc/nli_filter2/dataset/simple_test_corpus/out",
      "editable": true
    }
  ]
}