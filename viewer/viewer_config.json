{
  // Datasets shown by the viewer: an nli_filter.py output folder + the corpus it was made from.
  // Paths are relative to this file. Remote examples: see viewer_config.example.json
  "cache_dir": ".viewer_cache",
  "cache_max_gb": 20,
  "cors_origins": [
    "http://localhost:3000",
    "http://127.0.0.1:3000"
  ],
  // Dynamic datasets: every run folder in this folder is paired with the corpus it was made from (as recorded in its
  // summary.json); the most recent nli_filter.py run and the most recent nli_label.py run per corpus are shown, next
  // to the datasets below (these always win). Report of all run folders: python -m nli_viewer runs
  "auto_datasets": "../dataset",
  "datasets": [
    {
      "name": "test_corpus",
      "corpus": "../dataset/test_corpus",
      "output": "../dataset/out_test_corpus",
      "editable": true
    },
    {
      "name": "cases",
      "title": "Policy cases: one file per case (Level 0 / 1 / 2 + edge cases)",
      "description": "labels/cases_v1.json as a corpus (tools/build_cases_corpus.py). Labels: out_label_cases on the Labels pages; try one by one on /labeltry.",
      "corpus": "../dataset/test_corpus_cases",
      "editable": true
    },
    {
      "name": "germany",
      "title": "Germany test",
      "corpus": "../dataset/test_corpus_de",
      "output": "../dataset/out_test_corpus_de"
    },
    {
      "name": "longtest",
      "title": "Russia Long test",
      "corpus": "../dataset/test_corpus_long",
      "output": "../dataset/out_test_corpus_long",
      "editable": true
    },
    {
      "name": "ru_plain",
      "title": "test_russia: russian.json",
      "corpus": "../dataset/test_ru",
      "output": "../dataset/out_ru_plain"
    },
    {
      "name": "ru_kw",
      "title": "test_russia: russian_kw.json",
      "corpus": "../dataset/test_ru",
      "output": "../dataset/out_ru_kw"
    },
    {
      "name": "sftp_test",
      "title": "test_russia: russian_kw.json",
      "corpus": "sftp://download:download@192.168.170.200/home/download/hkc_test/test_corpus",
      "output": "D:/hkc/sftp_run/out_test_corpus",
      "editable": true
    },
    {
      "name": "cases_ru",
      "title": "Russia-side policy cases",
      "corpus": "../dataset/test_corpus_cases_ru",
      "editable": true
    },
    {
      "name": "docs_ru",
      "title": "Russia-side test documents (several paragraphs each)",
      "description": "labels/russia_llm_docs_v1.json as a corpus (tools/build_russia_llm_docs.py); output: the labelling run with the judge.",
      "corpus": "../dataset/test_corpus_docs_ru",
      "output": "../dataset/out_label_docs_ru_judge",
      "editable": true
    }
  ]
}